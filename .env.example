# Copy to .env and fill from developer.paypal.com > Apps & Credentials > Sandbox.
# .env is gitignored. Nothing here belongs in the repository, the logs, or a screenshot.
PAYPAL_ENV=sandbox
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created by POST /v1/notifications/webhooks on the public URL (see README, "Webhooks").
PAYPAL_WEBHOOK_ID=
# Sandbox accounts used as payees and payer. The platform account must be a US business account:
# an NG business account is rejected at checkout with PAYEE_ACCOUNT_LOCKED_OR_CLOSED (measured).
PAYPAL_PLATFORM_MERCHANT_ID=
PAYPAL_PLATFORM_EMAIL=
PAYPAL_SELLER_EMAIL=
PAYPAL_FUNDER_EMAIL=
PAYPAL_DEBTOR_EMAIL=
# Optional second-pass reader for documents the deterministic parser cannot line up. Any
# OpenAI-compatible chat endpoint. With no values the app stays on the deterministic path.
EXTRACT_API_KEY=
EXTRACT_BASE_URL=
EXTRACT_MODEL=
# Optional second reader for photographed documents. A second model reads the same pixels, so a
# field the first model invented can be caught before the label parser ever sees the transcription.
# With no values a photograph gets one reader and the page says so.
EXTRACT_B_API_KEY=
EXTRACT_B_BASE_URL=
EXTRACT_B_MODEL=
# Optional. Defaults: PORT 3000, DB_PATH data/discountwindow.sqlite.
PORT=3000
# DEMO_PASSWORD turns on HTTP Basic for a public demo. The username picks the identity (exactly one of
# desk, seller, funder, debtor; anything else is refused) and each identity may only press its own
# side's buttons. One shared password means the role is self-declared — whoever holds it can also log
# in as `desk` — so it is a gate on the door, not an access control.
DEMO_PASSWORD=
# DEMO_PUBLIC_READ=1 lets anyone GET the book, the deal rooms, the refusals and the settlement book
# read-only, with no button offered; every POST, the API and the submit form stay behind the password.
DEMO_PUBLIC_READ=
# Set a side's own secret to stop that side accepting the shared password. Hand each party only its
# own line and the role stops being something you can type your way into. Any side left empty keeps
# using DEMO_PASSWORD.
DEMO_PASSWORD_DESK=
DEMO_PASSWORD_SELLER=
DEMO_PASSWORD_FUNDER=
DEMO_PASSWORD_DEBTOR=
